{
  "name": "lumaseed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted torrent downloader with a browser UI — no speed caps, no size limits",
  "scripts": {
    "start": "node start.js",
    "postinstall": "patch-package",
    "test": "node test/cipher.mjs && node test/e2e.mjs",
    "build:fx": "esbuild src/hyperspeed-entry.js --bundle --format=esm --minify --target=es2020 --outfile=site/assets/hyperspeed.min.js"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "archiver": "^8.0.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "patch-package": "^8.0.1",
    "webtorrent": "^3.0.16"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "postprocessing": "^6.39.3",
    "three": "^0.185.1"
  }
}
